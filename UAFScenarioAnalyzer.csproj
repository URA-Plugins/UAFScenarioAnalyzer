<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsUraPlugin>true</IsUraPlugin>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>2026.9.26</Version>

    <!-- URA 插件元数据：供发布 manifest 使用 -->
    <PluginInternalName>UAFScenarioAnalyzer</PluginInternalName>
    <PluginDisplayName>解析UAF剧本回合信息</PluginDisplayName>
    <PluginAuthor>离披&amp;Github Contributors</PluginAuthor>
    <PluginRepositoryUrl>https://github.com/URA-Plugins/UAFScenarioAnalyzer</PluginRepositoryUrl>
    <PluginDependencies>EventLoggerPlugin</PluginDependencies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="deps\EventLoggerPlugin\EventLoggerPlugin.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="i18n\Game.Designer.cs">
      <DependentUpon>Game.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="i18n\UAF.Designer.cs">
      <DependentUpon>UAF.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="i18n\Game.resx">
      <LastGenOutput>Game.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="i18n\UAF.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>UAF.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="i18n\UAF.zh-CN.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UmamusumeResponseAnalyzer" Version="*" PrivateAssets="all" />
  </ItemGroup>

</Project>
